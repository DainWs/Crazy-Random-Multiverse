@startuml
title "Class diagram - Actions"

interface ActionContext {
 +getGame(): Game
 +getBoard(): Board
 +getSourcePlayer(): Player
 +getSourceZone(): Zone
 +getSourceCoordinate(): Coordinate
 +getSourceCard(): Card
 +getTargetPlayer(): Player
 +getTargetZone(): Zone
 +getTargetCoordinate(): Coordinate
 +getTargetCard(): Card
}

interface Action {
 +perform(ActionContext): ActionResult
}

class ActionResult {
 +isSuccessful(): boolean
 +getExceptionCode(): ExceptionCode
 +{static} successful(): ActionResult
 +{static} failed(ExceptionCode): ActionResult
 +{static} playerActionFailed(PlayerActionExceptionCode.Code): ActionResult
}

interface ActionContextFactory {
 +createContextFromTemplate(ActionContextTemplate): ActionContext
}

abstract class PlayerTurnAction {
 +<b>perform(ActionContext): final ActionResult</b>
 #{abstract} performPlayerAction(ActionContext): ActionResult
}

abstract class UseCardAction

ActionContextFactory ..> ActionContextTemplate
ActionContextFactory ..> ActionContext
ActionContext <|.. MutableActionContext

Action --> ActionContext
Action --> ActionResult

Action <|.. PlayerTurnAction
PlayerTurnAction <|-- PutAction
PlayerTurnAction <|-- MoveAction
PlayerTurnAction <|-- AttackAction
PlayerTurnAction <|-- EquipAction
PlayerTurnAction <|-- PassTurnAction
PlayerTurnAction <|-- SurrenderAction
PlayerTurnAction <|-- UseCardAction
UseCardAction <|-- UseSpellAction
@enduml
