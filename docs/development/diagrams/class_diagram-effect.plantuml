@startuml
title "Class diagram - Effects"

interface EffectContext {
 +getGame(): Game
 +getBoard(): Board
 +getSourcePlayer(): Player
 +getSourceZone(): Zone
 +getSourceCoordinate(): Coordinate
 +getSourceCard(): Card
 +getTargetPlayer(): Player
 +getTargetZone(): Zone
 +getTargetCoordinate(): Coordinate
 +getTargetCard(): Card
}

interface Effect {
 +getId(): EffectId
 +perform(EffectContext): void
}

class EffectId {
 +{static}<b>NONE: final EffectId</b>
 +isPresent(): boolean
 +getNumber(): long
 +equals(Object): boolean
 +hashCode(): int
 +{static} from(long): EffectId
}

interface EffectContextFactory {
 +createContextFromTemplate(EffectContextTemplate): EffectContext
}

note bottom of Effect
 Spells are **Post-MVP**.
end note

EffectContextFactory ..> EffectContextTemplate
EffectContextFactory ..> EffectContext

Effect --> EffectId
Effect --> EffectContext
@enduml
