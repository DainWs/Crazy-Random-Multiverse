@startuml
title "Activity - Player actions"
!pragma useVerticalIf on

start
switch (Player perform a subaction)
case (\n\n **Grab** card from **Hand**)

	switch (Player perform a subaction)
	case ( **Drop** card in his\nown free **ZoneSlot**)
		if (dropped card is **Combatant**) then (yes)
			:Perform **PutAction**;
		else (no)
		endif
	case (\n\n\n\n **Drop** card on his\nown **Card**)
		if (dropped card is **Equipment**) then (yes)
			:Perform **EquipAction**;
		else (no)
		endif
	case (Other)
	endswitch

case (\n\n\n **Grab** card from his\nown **ZoneSlot**)

	switch (Player perform a subaction)
	case ( **Drop** card in his\nown **ZoneSlot**)
		:Perform **MoveAction**;
	case (Other)
	endswitch

case (\n\n **Left click** on his\nown **Card** that can attack)
	if (**Left click** on\na valid **target**) then (yes)
		:Perform **AttackAction**;
	else (no)
		:Cancel the selection;
	endif
case (\n **Left click** on\n**Pass turn button**)
	:Start **PassTurnAction**;
case (\n **Left click** on\n**Surrender button**)
	if (**Left click** on\n**confirm button**) then (yes)
		:Start **SurrenderAction**;
	else (no)
	endif
endswitch





stop
@enduml
