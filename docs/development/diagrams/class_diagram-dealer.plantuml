@startuml
title "Class diagram - Dealer"

class Dealer {
 -deck: Deck
 -dealStrategyFactory: DealStrategyFactory
 +Dealer(Deck)
 +dealCardsToAlivePlayers(Game): void
 +dealCardsToPlayer(Game, Player): void
 +dealCardsToPlayer(Game, Player, DealStrategy): void
 +setDealStrategyFactory(DealStrategyFactory): void
}

interface Deck {
 +drawWarrior(WarriorRarity): Optional<Warrior>
 +drawEquipment(): Optional<Equipment>
 +drawLeader(): Optional<Leader>
 +drawSpell(): Optional<Spell>
}

interface DealStrategy {
 +drawFrom(Deck): List<Card>
}

interface DealStrategyFactory {
 +createStrategy(int): DealStrategy
}

Dealer *--> Deck
Dealer o--> DealStrategyFactory
Dealer ..> DealStrategy
DealStrategyFactory ..> DealStrategy
DealStrategy --> Deck

Deck <|.. MemoryCardRepository

DealStrategy <|.. LeaderStrategy
DealStrategy <|.. WarriorStrategy
DealStrategy <|.. EquipmentStrategy
DealStrategy <|.. SpellStrategy
DealStrategy <|.. ComposedStrategy

DealStrategyFactory <|.. RandomDealStrategyFactory
DealStrategyFactory <|.. ClassicDealStrategyFactory

@enduml
