@startuml 
title "Usecases"
left to right direction

actor Spectator
actor PlayerWithTurn
actor Player 
actor PartyOwner
actor PartyMember
actor User

:Player: <|-r- :PlayerWithTurn:
:PartyMember: <|-r- :PartyOwner:

:User: --> (Create party)
:User: --> (Join party)
:User: --> (View party list)
:User: --> (Manage account)

:PartyMember: --> (View party info)
:PartyMember: --> (Leave party)

:PartyOwner: --> (Manage party)
:PartyOwner: --> (Start game)

:Spectator: --> (Exit game)
:Spectator: --> (View game)

:Player: --> (View game)

:PlayerWithTurn: --> (Put card)
:PlayerWithTurn: --> (Move card)
:PlayerWithTurn: --> (Attack card)
:PlayerWithTurn: --> (Equip card)
:PlayerWithTurn: --> (Surrender)
:PlayerWithTurn: --> (Use spell [Post-MVP])
:PlayerWithTurn: --> (Pass turn)
@enduml 