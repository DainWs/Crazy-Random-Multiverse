@startuml
title "Class diagram - Card"

abstract class Card {
 -code: CardCode
 #Card(long)
 +getCode(): CardCode
 +{abstract} getType(): CardType
 +isType(CardType): boolean
 +equals(Object): boolean
 +hashCode(): int
 +toString(): String
}

class CardCode {
 -code: long
 -type: CardType
 +CardCode(long, CardType)
 +code(): long
 +codeText(): String
 +type(): CardType
 +isType(CardType): boolean
 +equals(Object): boolean
 +hashCode(): int
 +toString(): String
 +{static} from(String, CardType): CardCode
}

class Spell {
 -effectId: EffectId
 +getType(): CardType
 +getEffectId(): EffectId
 +{static} newInstance(long, long): Spell
 +{static} newInstance(long, EffectId): Spell
}

class Equipment {
 -damage: double
 -armor: double
 -health: double
 -skill: Skill
 +update(): void
 +getType(): CardType
 +getDamageValue(): double
 +getArmorValue(): double
 +getHealthValue(): double
 +hasSkill(): boolean
 +getSkill(): Skill
 +toString(): String
 +{static} builder(): Builder
}

class EquipmentBuilder as "Builder" {
 +withCode(long): Builder
 +withSkill(Skill): Builder
 +withDamage(double): Builder
 +withDamageBuff(double): Builder
 +withDamageDebuff(double): Builder
 +withArmor(double): Builder
 +withArmorBuff(double): Builder
 +withArmorDebuff(double): Builder
 +withHealth(double): Builder
 +withHealthBuff(double): Builder
 +withHealthDebuff(double): Builder
 +build(): Equipment
}

abstract class Combatant {
 #damage: Damage
 #armor: Armor
 #health: Health
 #equipment: List<Equipment>
 #skill: Skill
 #attackCount: int
 #maxAttackCount: int
 #attackCooldown: Cooldown
 -baseDamage: Damage
 -baseArmor: Armor
 -baseHealth: Health
 #Combatant(long)
 +update(): void
 +canAttack(): boolean
 +receiveDamageFrom(Combatant): AttackResult
 +startPlacementCooldown(): void
 +equip(Equipment): void
 +isAlive(): boolean
 +hasSkill(): boolean
 +getEquipment(): List<Equipment>
 +getBaseDamage(): Damage
 +getBaseArmor(): Armor
 +getBaseHealth(): Health
 +getDamage(): Damage
 +getArmor(): Armor
 +getHealth(): Health
 +getSkill(): Skill
 +toString(): String
}

class Leader {
 +Leader(long)
 +startPlacementCooldown(): void
 +getType(): CardType
}

class Warrior {
 -rarity: WarriorRarity
 #Warrior(Builder)
 +getType(): CardType
 +getRarity(): WarriorRarity
 +isRarity(WarriorRarity): boolean
 +{static} warriorBuilder(WarriorRarity): Builder
 +{static} commonWarriorBuilder(): Builder
 +{static} uncommonWarriorBuilder(): Builder
 +{static} rareWarriorBuilder(): Builder
 +{static} epicWarriorBuilder(): Builder
 +{static} legendaryWarriorBuilder(): Builder
 +{static} mythicWarriorBuilder(): Builder
}

class WarriorBuilder as "Builder" {
 +withCode(long): Builder
 +withSkill(Skill): Builder
 +withDamage(Damage): Builder
 +withNoneDamage(): Builder
 +withInfiniteDamage(): Builder
 +withPhysicalDamage(double): Builder
 +withMagicDamage(double): Builder
 +withTrueDamage(double): Builder
 +withArmor(Armor): Builder
 +withNoneArmor(): Builder
 +withPhysicalArmor(double): Builder
 +withMagicArmor(double): Builder
 +withHealth(Health): Builder
 +withInfiniteHealth(): Builder
 +withHealth(double): Builder
 +withHealth(double, double): Builder
 +withEquipment(Equipment): Builder
 +build(): Warrior
}

enum CardType {
 LEADER
 WARRIOR
 EQUIPMENT
 SPELL
}

enum WarriorRarity {
 COMMON
 UNCOMMON
 RARE
 EPIC
 LEGENDARY
 MYTHIC
}

Card *--> CardCode
Card --> CardType
CardCode --> CardType
Card <|-- Spell
Card <|-- Equipment
Card <|-- Combatant
Combatant o--> "0..N" Equipment
Combatant o--> "0..1" Skill
Equipment o--> "0..1" Skill
Combatant *--> Cooldown
Combatant ..> AttackResult
Combatant <|-- Leader
Combatant <|-- Warrior

Equipment --> EquipmentBuilder
Warrior --> WarriorBuilder
Warrior *--> WarriorRarity

note as SeeMore
 **See more:**
  class_diagram-effect.plantuml
  class_diagram-statistic.plantuml
end note

@enduml
